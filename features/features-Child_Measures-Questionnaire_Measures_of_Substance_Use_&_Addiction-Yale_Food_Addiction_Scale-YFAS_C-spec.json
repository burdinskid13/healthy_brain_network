{
    "assessment": "Child Measures",
    "domains": "Questionnaire_Measures_of_Substance_Use_&_Addiction",
    "measures": "Yale Food Addiction Scale",
    "abbrevs": "YFAS_C",
    "datadic": "YFAS_C",
    "add_features": {
        "filename": "Demographic_Features.csv",
        "cols_to_include": [
            "Sex",
            "Age",
            "Diagnosis",
            "comorbidities",
            "Race",
            "Ethnicity"
        ]
    },
    "preprocessing": {
        "preprocess": true,
        "cols_to_drop": [
            "EID",
            "Comment_ID",
            "Unnamed",
            "Administration",
            "Days_Baseline",
            "Data_entry",
            "START_DATE",
            "Year",
            "Site",
            "Season",
            "Visit_label",
            "Study",
            "PSCID",
            "Release_Number"
        ],
        "cols_to_ignore": [
            "Identifiers"
        ],
        "upsample": true,
        "threshold": false,
        "clf_info": {
            "numeric": [
                [
                    "sklearn.impute",
                    "SimpleImputer",
                    {
                        "strategy": "mean"
                    }
                ],
                [
                    "sklearn.preprocessing",
                    "StandardScaler",
                    {}
                ]
            ]
        }
    }
}