[tool.poetry]
name = "healthy-brain-network"
version = "0.1.0"
description = ">=3.9,<3.12"
authors = ["Maedbh King <mking86@uwo.ca>"]
license = "MIT"
readme = "README.md"
packages = [{include = "healthy_brain_network"}]

[tool.poetry.dependencies]
python = ">=3.10,<3.12"
numpy = "^1.24.1"
scikit-learn = "^1.2.0"
pandas = "^1.5.2"
seaborn = "^0.12.2"
nibabel = "^4.0.2"
nilearn = "^0.9.2"
plotly = "^5.11.0"
h5py = "^3.7.0"
deepdish = "^0.3.7"
umap-learn = "^0.5.3"
pydra-ml = "^0.5.1"

[tool.poetry.group.dev.dependencies]
pylint = "^2.15.9"
jupyter = "^1.0.0"

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"
